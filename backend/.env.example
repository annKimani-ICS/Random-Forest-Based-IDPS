# Database Configuration
# Use postgres superuser for setup, then switch to dedicated user
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/ids_idps_db
# For production, use dedicated user:
# DATABASE_URL=postgresql+psycopg2://ids_user:YOUR_SECURE_PASSWORD@localhost:5432/ids_idps_db

# JWT Configuration
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ISSUER=IDS-IDPS

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_MFA=5/minute
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=5

# User Passwords (Optional - will be auto-generated if not set)
# Generate secure passwords: python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
ANALYST_PASSWORD=YOUR_ANALYST_PASSWORD_HERE
